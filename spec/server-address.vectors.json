{
  "spec": "server-address",
  "version": 1,
  "source": "docs/REWRITE.md §3.5.12, melogoldServer/docs/API.md §7.1. Читают ServerAddressPolicy (:core:domain), сервер и десктопы.",
  "input": "строка, которую ввёл пользователь",
  "expected": {
    "url": "base URL `scheme://host[:port][/prefix]` без `/` в конце — или отсутствует при отказе",
    "insecure": "true для http",
    "error": "код отказа: empty | malformed | unsupported_scheme | credentials_or_params | https_required"
  },
  "rules": [
    "trim; без схемы — https://; схема и хост в нижнем регистре; `/` в конце убирается; префикс пути сохраняется",
    "userinfo, query или fragment — отказ credentials_or_params",
    "https — на любой хост; http — только на приватный: IPv4 10/8, 172.16/12, 192.168/16, 169.254/16, 127/8, 100.64/10; IPv6 fc00::/7, fe80::/10, ::1; имя *.local, *.lan, *.home.arpa, *.internal или из одного слова",
    "проверку после DNS (все адреса приватные) делает вызывающий код, здесь имена не резолвятся"
  ],
  "cases": [
    { "id": "bare-host", "input": "music.example.com", "expected": { "url": "https://music.example.com", "insecure": false } },
    { "id": "trim-case-slash", "input": "  HTTPS://Music.Example.COM/  ", "expected": { "url": "https://music.example.com", "insecure": false } },
    { "id": "path-prefix", "input": "https://example.com/melogold/", "expected": { "url": "https://example.com/melogold", "insecure": false } },
    { "id": "path-prefix-case-kept", "input": "https://example.com/Music", "expected": { "url": "https://example.com/Music", "insecure": false } },
    { "id": "https-port", "input": "https://example.com:8443", "expected": { "url": "https://example.com:8443", "insecure": false } },
    { "id": "sslip", "input": "178-250-187-202.sslip.io", "expected": { "url": "https://178-250-187-202.sslip.io", "insecure": false } },
    { "id": "https-public-ip", "input": "https://8.8.8.8", "expected": { "url": "https://8.8.8.8", "insecure": false } },
    { "id": "http-192-168", "input": "http://192.168.1.50:8080", "expected": { "url": "http://192.168.1.50:8080", "insecure": true } },
    { "id": "http-10", "input": "http://10.0.0.2", "expected": { "url": "http://10.0.0.2", "insecure": true } },
    { "id": "http-172-16", "input": "http://172.16.0.1", "expected": { "url": "http://172.16.0.1", "insecure": true } },
    { "id": "http-172-31", "input": "http://172.31.255.254", "expected": { "url": "http://172.31.255.254", "insecure": true } },
    { "id": "http-172-32", "input": "http://172.32.0.1", "expected": { "error": "https_required" } },
    { "id": "http-loopback", "input": "http://127.0.0.1:3000/", "expected": { "url": "http://127.0.0.1:3000", "insecure": true } },
    { "id": "http-link-local", "input": "http://169.254.10.10", "expected": { "url": "http://169.254.10.10", "insecure": true } },
    { "id": "http-tailscale", "input": "http://100.64.1.1", "expected": { "url": "http://100.64.1.1", "insecure": true } },
    { "id": "http-cgnat-edge", "input": "http://100.128.0.1", "expected": { "error": "https_required" } },
    { "id": "http-single-label", "input": "http://nas:8080", "expected": { "url": "http://nas:8080", "insecure": true } },
    { "id": "http-localhost", "input": "http://localhost:3000", "expected": { "url": "http://localhost:3000", "insecure": true } },
    { "id": "http-local", "input": "http://music.local", "expected": { "url": "http://music.local", "insecure": true } },
    { "id": "http-lan", "input": "http://box.lan", "expected": { "url": "http://box.lan", "insecure": true } },
    { "id": "http-home-arpa", "input": "http://srv.home.arpa", "expected": { "url": "http://srv.home.arpa", "insecure": true } },
    { "id": "http-internal", "input": "http://melogold.internal", "expected": { "url": "http://melogold.internal", "insecure": true } },
    { "id": "http-public-name", "input": "http://example.com", "expected": { "error": "https_required" } },
    { "id": "http-public-ip", "input": "http://8.8.8.8", "expected": { "error": "https_required" } },
    { "id": "not-an-ip", "input": "http://300.1.1.1", "expected": { "error": "malformed" } },
    { "id": "http-ipv6-loopback", "input": "http://[::1]:8080", "expected": { "url": "http://[::1]:8080", "insecure": true } },
    { "id": "http-ipv6-ula", "input": "http://[fd12:3456::1]", "expected": { "url": "http://[fd12:3456::1]", "insecure": true } },
    { "id": "http-ipv6-link-local", "input": "http://[fe80::1]", "expected": { "url": "http://[fe80::1]", "insecure": true } },
    { "id": "http-ipv6-public", "input": "http://[2001:db8::1]", "expected": { "error": "https_required" } },
    { "id": "userinfo", "input": "https://user:pass@example.com", "expected": { "error": "credentials_or_params" } },
    { "id": "query", "input": "https://example.com/?a=1", "expected": { "error": "credentials_or_params" } },
    { "id": "fragment", "input": "https://example.com/#x", "expected": { "error": "credentials_or_params" } },
    { "id": "ftp", "input": "ftp://example.com", "expected": { "error": "unsupported_scheme" } },
    { "id": "empty", "input": "", "expected": { "error": "empty" } },
    { "id": "blank", "input": "   ", "expected": { "error": "empty" } },
    { "id": "no-host", "input": "https://", "expected": { "error": "malformed" } },
    { "id": "space-in-host", "input": "https://exa mple.com", "expected": { "error": "malformed" } }
  ]
}

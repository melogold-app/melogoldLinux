{
  "$comment": "Hardware id of a device (docs/API.md §1.6 Hwid, docs/DESIGN.md §4.6). Checked by src/modules/auth/hwid.test.ts; the same for every client.",
  "license": "CC0-1.0",
  "algorithm": "hwid = lowercase hex(sha256(UTF-8(\"melogold-hwid-v1|\" + platformId + \"|\" + serverId))); serverId is /server/info.serverId, so every server sees another hwid",
  "platformIds": {
    "android": "Settings.Secure.ANDROID_ID as returned",
    "macos": "IOPlatformUUID as returned (upper case)",
    "windows": "HKLM\\SOFTWARE\\Microsoft\\Cryptography\\MachineGuid + \"|\" + installSalt",
    "linux": "contents of /etc/machine-id without the newline + \"|\" + installSalt",
    "fallback": "a random UUID v4 kept in private storage excluded from backups (any platform)",
    "installSalt": "a random UUID v4 created on the first start in the application data"
  },
